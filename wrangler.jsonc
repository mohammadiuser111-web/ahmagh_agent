// wrangler.jsonc — پیکربندی استاندارد Cloudflare Workers (فرمت پیشنهادی جدید)
// مستندات: https://developers.cloudflare.com/workers/wrangler/configuration/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ahmagh-agent",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",

  // دیتابیسِ موجود اکانت (همه‌ی دیتابیس‌های قبلی خالی بودند؛ دیتابیس جدید نساخته شد)
  // اگر دیتابیس دیگری می‌خواهید، database_name و database_id را عوض کنید.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "iman",
      "database_id": "dcf6cf3f-6fa5-4382-956c-ae4614ce7fb7",
      "migrations_dir": "migrations"
    }
  ],

  // اتصال به Workers AI — برای استخراج ساختار تسک از زبان طبیعی فارسی
  "ai": {
    "binding": "AI"
  },

  // موتور یادآوری — هر ۱۰ دقیقه اجرا می‌شود
  "triggers": {
    "crons": ["*/10 * * * *"]
  },

  "observability": {
    "enabled": true
  },

  // متغیرهای عمومی (غیرحساس) — مقادیر حساس فقط از طریق `wrangler secret put`
  "vars": {
    "TELEGRAM_BOT_USERNAME": "ahmagh_agent_bot",
    // مدل اصلی — GLM-5.3 Flash نیازمند پلن پولی Workers است؛
    // روی پلن رایگان خودکار به مدل جایگزین (رایگان) برمی‌گردیم
    "AI_MODEL": "@cf/zai-org/glm-5.3-flash",
    "AI_FALLBACK_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
  }
}
