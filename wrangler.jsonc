// wrangler.jsonc — پیکربندی استاندارد Cloudflare Workers (فرمت پیشنهادی جدید)
// مستندات: https://developers.cloudflare.com/workers/wrangler/configuration/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ahmagh-agent",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",

  // 🌐 وب‌اپ — فایل‌های استاتیک از public/ سرو می‌شوند؛ مسیرهای API/وبهوک اول به ورکر می‌روند
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/webhook", "/set-webhook", "/health"]
  },

  // دیتابیسِ موجود اکانت (همه‌ی دیتابیس‌های قبلی خالی بودند؛ دیتابیس جدید نساخته شد)
  // اگر دیتابیس دیگری می‌خواهید، database_name و database_id را عوض کنید.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "iman",
      "database_id": "dcf6cf3f-6fa5-4382-956c-ae4614ce7fb7",
      "migrations_dir": "migrations"
    }
  ],

  // اتصال به Workers AI — برای استخراج ساختار تسک از زبان طبیعی فارسی
  "ai": {
    "binding": "AI"
  },

  // موتور یادآوری هر دقیقه — گزارش روزانه (۸ صبح/شب تهران) هم داخل همین تیک چک می‌شود
  // (پلن Free سقف ۵ کرونِ اکانت را دارد؛ به همین دلیل کرون اضافه نمی‌کنیم)
  "triggers": {
    "crons": ["* * * * *"]
  },

  "observability": {
    "enabled": true
  },

  // متغیرهای عمومی (غیرحساس) — مقادیر حساس فقط از طریق `wrangler secret put`
  "vars": {
    "TELEGRAM_BOT_USERNAME": "ahmagh_agent_bot",
    // آدرس وب‌اپ برای دکمه‌ی «🌐 نسخه وب» بات
    "WEB_APP_URL": "https://ahmagh-agent.nova-0e7442.workers.dev",
    // مدل هوش مصنوعی — llama-3.3-70b (رایگان و بدون محدودیت پلن)
    "AI_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct",
    "AI_FALLBACK_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    // گزارش مصرف و هزینه (به‌همراه secret «CF_API_TOKEN» با دسترسی آنالیتیکس)
    "CF_ACCOUNT_ID": "4d67f0848c83ace5ffa115b98bb1b2ee",
    "D1_DATABASE_ID": "dcf6cf3f-6fa5-4382-956c-ae4614ce7fb7"
  }
}
