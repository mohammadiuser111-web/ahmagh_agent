{
  "name": "ahmagh-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "🤖 AI Task/Workflow Manager Telegram bot — Cloudflare Workers + D1 + Workers AI",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "dry-run": "wrangler deploy --dry-run --outdir=dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply iman --local",
    "db:migrate:remote": "wrangler d1 migrations apply iman --remote",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250906.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
